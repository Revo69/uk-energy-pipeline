# Automatically normalize line endings
* text=auto

# Python and text files — always LF in repo
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.env text eol=lf
*.example text eol=lf
*.toml text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.zip binary
*.parquet binary